      "id": "e214b480-f8e1-4d8a-a0b8-917824d86bb8",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nif (response.errors?.length) {\n  throw new Error(JSON.stringify(response.errors));\n}\n\nif (!response.data) {\n  throw new Error('Neo4j response is missing data');\n}\n\nconst { fields, values } = response.data;\n\nconst results = values.map(row =>\n  Object.fromEntries(\n    fields.map((field, index) => [field, row[index]])\n  )\n);\n\nreturn [{\n  json: {\n    count: results.length,\n    results\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -48
      ],
      "id": "e06a83da-1100-47b1-9d7e-f3d190f00f07",
      "name": "Format results"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const question = item.json.question;\n\n  if (typeof question !== 'string' || !question.trim()) {\n    throw new Error(\n      'Missing required input: question must be a non-empty string.'\n    );\n  }\n\n  return {\n    json: {\n      question: question.trim()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
