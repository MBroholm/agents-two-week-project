    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/neo4j/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  statement: `\n    CYPHER 25\n    MATCH (movie:Movie)\n    SEARCH movie IN (\n      VECTOR INDEX movie_embedding\n      FOR $embedding\n      LIMIT 5\n    ) SCORE AS score\n    RETURN movie.imdbId AS imdbId,\n           movie.title AS title,\n           movie.year AS year,\n           movie.plot AS plot,\n           movie.source AS source,\n           score\n    ORDER BY score DESC\n  `,\n  parameters: {\n    embedding: $json.embeddings[0]\n  }\n} }}",
        "options": {}
      },
