        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  statement: `\n    MATCH (seed:Movie {imdbId: $imdbId})\n    MATCH (seed)-[:DIRECTED_BY]->(person:Person)\n          <-[:DIRECTED_BY]-(other:Movie)\n    WHERE other <> seed\n    RETURN seed.title AS selectedMovie,\n           other.imdbId AS imdbId,\n           other.title AS title,\n           other.year AS year,\n           'shared director' AS connection,\n           person.name AS person,\n           other.source AS source\n\n    UNION\n\n    MATCH (seed:Movie {imdbId: $imdbId})\n    MATCH (seed)<-[:ACTED_IN]-(person:Person)\n          -[:ACTED_IN]->(other:Movie)\n    WHERE other <> seed\n    RETURN seed.title AS selectedMovie,\n           other.imdbId AS imdbId,\n           other.title AS title,\n           other.year AS year,\n           'shared actor' AS connection,\n           person.name AS person,\n           other.source AS source\n  `,\n  parameters: {\n    imdbId: $json.imdbId\n  }\n} }}",
        "options": {}
      },
